# ФАКТУРА+ сървър - настройки. Копирайте като .env (локално) или ги
# въведете в Render -> услугата -> Environment. Празно = изключено.

# --- Задължителни -----------------------------------------------------
# Връзката с базата (MongoDB Atlas -> Connect -> Drivers).
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net
# Името на базата.
DB_NAME=fakturaplus
# production на живо: сигурни бисквитки, без подробни грешки.
ENVIRONMENT=production
# Адресът на сайта (приложението): за връзките в имейлите и за CORS.
FRONTEND_URL=https://your-frontend.onrender.com
# Още адреси, от които сайтът може да вика сървъра (със запетаи).
CORS_ORIGINS=

# --- AI: сканиране на фактури и асистент (без него са изключени) -------
ANTHROPIC_API_KEY=

# --- Имейли: забравена парола, пакет за счетоводителя, архив ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Фактура+ <noreply@your-domain.bg>

# --- Плащания за сканиране (Stripe; без тях сканирането е безплатно) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# false = сканирането не се таксува, дори със Stripe.
SCAN_CREDITS_ENFORCED=true

# --- Известия на телефона (Web Push) ------------------------------------
# Частен VAPID ключ (base64url). Публичният се изчислява от него.
# Нов ключ (в папката backend):
# python -c "import base64;from py_vapid import Vapid;v=Vapid();v.generate_keys();print(base64.urlsafe_b64encode(v.private_key.private_numbers().private_value.to_bytes(32,'big')).rstrip(b'=').decode())"
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.bg

# --- Файлово хранилище: дневен архив и снимки на фактурите -------------
# S3-съвместимо (Cloudflare R2, Backblaze B2, AWS S3...). Без него няма
# дневен архив извън базата, а снимките остават в базата. С него старите
# снимки се преместват там постепенно. Кофата трябва да е частна.
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Адресът на доставчика (за R2: https://<account-id>.r2.cloudflarestorage.com);
# празно за AWS.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
# Колко дни се пазят дневните копия (по подразбиране 30).
BACKUP_KEEP_DAYS=30

# --- Вход -----------------------------------------------------------------
# Втора стъпка при вход е задължителна за собственик и счетоводител (14 дни
# след въвеждането или след откриването на профила). false я прави по избор.
TWO_FACTOR_REQUIRED=true

# --- Други ----------------------------------------------------------------
# Имейлът на администратора на програмата: вижда отзивите и грешките на
# всички фирми в „Състояние“. Без него няма администратор.
ADMIN_EMAIL=
# Часовата зона на бизнес деня (по подразбиране Europe/Sofia).
BUSINESS_TIMEZONE=Europe/Sofia
